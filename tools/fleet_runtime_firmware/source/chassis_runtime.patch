diff --git a/main/config/runtime_tuning.h b/main/config/runtime_tuning.h
new file mode 100644
index 00000000..0fe6ce9a
--- /dev/null
+++ b/main/config/runtime_tuning.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+struct RuntimeTuning {
+    uint32_t schema_version = 1;
+    uint32_t telemetry_hz = 50;
+    uint32_t slow_telemetry_hz = 10;
+    float gyro_scale_x = 1.0f;
+    float gyro_scale_y = 1.0f;
+    float gyro_scale_z = 1.0f;
+};
+
+inline bool runtime_tuning_valid(const RuntimeTuning &value) {
+    return value.schema_version == 1 && value.telemetry_hz >= 1 && value.telemetry_hz <= 50 &&
+           value.slow_telemetry_hz >= 1 && value.slow_telemetry_hz <= 10 &&
+           std::isfinite(value.gyro_scale_x) && value.gyro_scale_x >= 0.5f && value.gyro_scale_x <= 2.0f &&
+           std::isfinite(value.gyro_scale_y) && value.gyro_scale_y >= 0.5f && value.gyro_scale_y <= 2.0f &&
+           std::isfinite(value.gyro_scale_z) && value.gyro_scale_z >= 0.5f && value.gyro_scale_z <= 2.0f;
+}
+
+// Called from the existing 20 ms network service loop. Preserve average rate at
+// non-divisors of 50 Hz, while dropping missed deadlines instead of bursting.
+struct TelemetryGate {
+    int64_t next_us = 0;
+    uint32_t rate_hz = 0;
+    bool due(int64_t now_us, uint32_t requested_hz) {
+        if (requested_hz == 0) return false;
+        if (rate_hz != requested_hz) {
+            rate_hz = requested_hz;
+            next_us = now_us;
+        }
+        if (now_us < next_us) return false;
+        const int64_t period = (1000000LL + requested_hz - 1) / requested_hz;
+        next_us += period;
+        if (next_us <= now_us) next_us = now_us + period;
+        return true;
+    }
+};
diff --git a/main/config/runtime_tuning_store.cpp b/main/config/runtime_tuning_store.cpp
new file mode 100644
index 00000000..7ccb0fac
--- /dev/null
+++ b/main/config/runtime_tuning_store.cpp
@@ -0,0 +1,58 @@
+#include "runtime_tuning_store.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "nvs.h"
+
+static RuntimeTuning s_tuning;
+static portMUX_TYPE s_lock = portMUX_INITIALIZER_UNLOCKED;
+static SemaphoreHandle_t s_save_mutex = nullptr;
+static constexpr const char *kNamespace = "experiment_cfg";
+static constexpr const char *kKey = "tuning_v1";
+
+RuntimeTuning runtime_tuning_get() {
+    portENTER_CRITICAL(&s_lock);
+    RuntimeTuning value = s_tuning;
+    portEXIT_CRITICAL(&s_lock);
+    return value;
+}
+
+static void apply(const RuntimeTuning &value) {
+    portENTER_CRITICAL(&s_lock);
+    s_tuning = value;
+    portEXIT_CRITICAL(&s_lock);
+}
+
+esp_err_t runtime_tuning_init() {
+    if (s_save_mutex == nullptr) s_save_mutex = xSemaphoreCreateMutex();
+    if (s_save_mutex == nullptr) return ESP_ERR_NO_MEM;
+    apply(RuntimeTuning{});
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNamespace, NVS_READONLY, &handle);
+    if (err != ESP_OK) return err;
+    RuntimeTuning value;
+    size_t size = sizeof(value);
+    err = nvs_get_blob(handle, kKey, &value, &size);
+    nvs_close(handle);
+    if (err == ESP_OK) {
+        if (size != sizeof(value)) return ESP_ERR_INVALID_SIZE;
+        if (!runtime_tuning_valid(value)) return ESP_ERR_INVALID_ARG;
+        apply(value);
+    }
+    return err;
+}
+
+esp_err_t runtime_tuning_save(const RuntimeTuning &value) {
+    if (!runtime_tuning_valid(value)) return ESP_ERR_INVALID_ARG;
+    if (s_save_mutex == nullptr) return ESP_ERR_INVALID_STATE;
+    if (xSemaphoreTake(s_save_mutex, pdMS_TO_TICKS(1000)) != pdTRUE) return ESP_ERR_TIMEOUT;
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNamespace, NVS_READWRITE, &handle);
+    if (err == ESP_OK) {
+        err = nvs_set_blob(handle, kKey, &value, sizeof(value));
+        if (err == ESP_OK) err = nvs_commit(handle);
+        nvs_close(handle);
+    }
+    if (err == ESP_OK) apply(value);
+    xSemaphoreGive(s_save_mutex);
+    return err;
+}
