diff --git a/tests/motion_stubs/system_globals.h b/tests/motion_stubs/system_globals.h
new file mode 100644
index 00000000..f59fecfd
--- /dev/null
+++ b/tests/motion_stubs/system_globals.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include "msg/motion_msg.h"
+#include "msg/pid_msg.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+
+static constexpr int pdTRUE = 1;
+static constexpr int pdFALSE = 0;
+static constexpr int pdPASS = 1;
+static constexpr uint32_t portTICK_PERIOD_MS = 1;
+#define pdMS_TO_TICKS(ms) (ms)
+
+struct StubQueue {
+    std::array<unsigned char, 512> data = {};
+    std::size_t size = 0;
+    bool available = false;
+};
+
+struct SystemGlobals {
+    struct Queues {
+        StubQueue* imu_state = nullptr;
+        StubQueue* motion_cmd = nullptr;
+        StubQueue* gamepad_motion_cmd = nullptr;
+        StubQueue* speedpid_cmd = nullptr;
+        StubQueue* positionpid_cmd = nullptr;
+        StubQueue* motion_state = nullptr;
+    } queues;
+    struct Flags {
+        bool gamepad_override_active = false;
+        bool emergency_stop = false;
+        bool motion_busy = false;
+    } flags;
+    struct Control { PidMsg speed_pid; PidMsg position_pid; } control;
+};
+
+extern SystemGlobals stub_globals;
+extern uint32_t stub_now_ms;
+extern std::function<void()> stub_after_delay;
+inline SystemGlobals& system_globals() { return stub_globals; }
+inline uint32_t xTaskGetTickCount() { return stub_now_ms; }
+
+inline int xQueuePeek(StubQueue* queue, void* output, int) {
+    if (queue == nullptr || !queue->available) return pdFALSE;
+    std::memcpy(output, queue->data.data(), queue->size);
+    return pdTRUE;
+}
+inline int xQueueReceive(StubQueue* queue, void* output, int timeout) {
+    const int result = xQueuePeek(queue, output, timeout);
+    if (result == pdTRUE) queue->available = false;
+    return result;
+}
+inline int xQueueOverwrite(StubQueue* queue, const void* input) {
+    std::memcpy(queue->data.data(), input, queue->size);
+    queue->available = true;
+    return pdPASS;
+}
+inline void vTaskDelay(uint32_t duration_ms) {
+    stub_now_ms += duration_ms;
+    stub_after_delay();
+}
diff --git a/tests/motion_task_watchdog_test.cpp b/tests/motion_task_watchdog_test.cpp
new file mode 100644
index 00000000..694090dc
--- /dev/null
+++ b/tests/motion_task_watchdog_test.cpp
@@ -0,0 +1,129 @@
+#include "board.h"
+#include "motion_safety.h"
+
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <utility>
+#include <vector>
+
+void motion_task(void*);
+SystemGlobals stub_globals;
+uint32_t stub_now_ms = 0;
+std::function<void()> stub_after_delay;
+StubRobot robot;
+
+namespace {
+struct EndSimulation {};
+StubQueue nav_queue, gamepad_queue, state_queue;
+std::vector<std::pair<uint32_t, MotionMsg>> statuses;
+
+void Enqueue(const MotionMsg& command) { xQueueOverwrite(&nav_queue, &command); }
+MotionMsg Velocity(uint32_t now, uint32_t sequence = 1) {
+    MotionMsg command;
+    assert(motion_safety::MakeMicroRosVelocity(0.25, 0, 0.7, now, sequence, &command));
+    return command;
+}
+
+void Reset() {
+    stub_globals = {};
+    stub_now_ms = 100;
+    robot = {};
+    statuses.clear();
+    nav_queue = {}; nav_queue.size = sizeof(MotionMsg);
+    gamepad_queue = {}; gamepad_queue.size = sizeof(MotionMsg);
+    state_queue = {}; state_queue.size = sizeof(MotionMsg);
+    stub_globals.queues.motion_cmd = &nav_queue;
+    stub_globals.queues.gamepad_motion_cmd = &gamepad_queue;
+    stub_globals.queues.motion_state = &state_queue;
+}
+
+void RunUntil(uint32_t until, const std::function<void()>& schedule = [] {}) {
+    stub_after_delay = [=] {
+        MotionMsg status;
+        assert(xQueuePeek(&state_queue, &status, 0) == pdTRUE);
+        statuses.push_back({stub_now_ms - 20, status});
+        if (stub_now_ms >= until) throw EndSimulation{};
+        schedule();
+    };
+    try { motion_task(nullptr); }
+    catch (const EndSimulation&) {}
+}
+
+void TestTimeoutStopsRealTaskAndFixesTelemetry() {
+    Reset(); Enqueue(Velocity(100)); RunUntil(740);
+    assert(robot.drives.size() == 1 && robot.drives.front().vx == 250);
+    assert(!robot.stops.empty() && robot.stops.front() == 600);
+    assert(statuses.front().second.target_wz == 0.7f);
+    for (const auto& row : statuses) {
+        if (row.first >= 600) {
+            assert(row.second.target_vx == 0 && row.second.target_wz == 0);
+            assert(row.second.cmd_vel_has_command && row.second.cmd_vel_timed_out);
+            assert(row.second.cmd_vel_received_sequence == 1);
+            assert(row.second.cmd_vel_applied_sequence == 1);
+        }
+    }
+}
+
+void TestRepeatedCommandRenewsFromReceiptTime() {
+    Reset(); Enqueue(Velocity(100));
+    RunUntil(1140, [] { if (stub_now_ms == 580) Enqueue(Velocity(580, 2)); });
+    assert(robot.drives.size() == 2 && robot.drives.back().now_ms == 580);
+    assert(robot.stops.front() == 1080);
+    assert(statuses.back().second.cmd_vel_applied_sequence == 2);
+}
+
+void TestGamepadHandoverCannotReviveExpiredNavigation() {
+    Reset(); Enqueue(Velocity(100));
+    MotionMsg gamepad; gamepad.source = MOTION_SRC_GAMEPAD; gamepad.target_vx = 100;
+    xQueueOverwrite(&gamepad_queue, &gamepad);
+    RunUntil(900, [] {
+        if (stub_now_ms == 200) stub_globals.flags.gamepad_override_active = true;
+        if (stub_now_ms == 820) stub_globals.flags.gamepad_override_active = false;
+    });
+    assert(robot.stops.front() == 820);
+    assert(std::any_of(robot.drives.begin(), robot.drives.end(), [](const DriveCall& call) {
+        return call.now_ms == 800 && call.vx == 100;
+    }));
+    assert(std::none_of(robot.drives.begin(), robot.drives.end(), [](const DriveCall& call) {
+        return call.now_ms >= 820;
+    }));
+}
+
+void TestFreshNavigationAfterGamepadAndOtherSources() {
+    Reset(); Enqueue(Velocity(100));
+    MotionMsg gamepad; gamepad.source = MOTION_SRC_GAMEPAD; gamepad.target_vx = 100;
+    xQueueOverwrite(&gamepad_queue, &gamepad);
+    RunUntil(1320, [] {
+        if (stub_now_ms == 200) stub_globals.flags.gamepad_override_active = true;
+        if (stub_now_ms == 780) Enqueue(Velocity(780, 2));
+        if (stub_now_ms == 820) stub_globals.flags.gamepad_override_active = false;
+    });
+    assert(robot.stops.front() == 1280);
+    assert(std::any_of(robot.drives.begin(), robot.drives.end(), [](const DriveCall& call) {
+        return call.now_ms == 820 && call.vx == 250;
+    }));
+    Reset();
+    auto mavlink = Velocity(100); mavlink.source = MOTION_SRC_UDP;
+    Enqueue(mavlink); RunUntil(900);
+    assert(robot.drives.size() == 1 && robot.stops.empty());
+    assert(!statuses.back().second.cmd_vel_has_command);
+}
+
+void TestMissingReceiptMetadataFailsClosed() {
+    Reset();
+    auto command = Velocity(100); command.cmd_vel_has_command = false;
+    Enqueue(command); RunUntil(180);
+    assert(robot.drives.empty() && robot.stops.front() == 100);
+    assert(statuses.back().second.target_vx == 0);
+}
+}  // namespace
+
+int main() {
+    TestTimeoutStopsRealTaskAndFixesTelemetry();
+    TestRepeatedCommandRenewsFromReceiptTime();
+    TestGamepadHandoverCannotReviveExpiredNavigation();
+    TestFreshNavigationAfterGamepadAndOtherSources();
+    TestMissingReceiptMetadataFailsClosed();
+    std::cout << "real motion_task watchdog simulations passed\n";
+}
diff --git a/tests/runtime_tuning_test.cpp b/tests/runtime_tuning_test.cpp
new file mode 100644
index 00000000..81064142
--- /dev/null
+++ b/tests/runtime_tuning_test.cpp
@@ -0,0 +1,64 @@
+#include "runtime_tuning_store.h"
+#include "nvs.h"
+#include <cassert>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+static std::vector<unsigned char> committed, pending;
+static int open_error=ESP_OK, set_error=ESP_OK, commit_error=ESP_OK;
+static unsigned writes=0, commits=0;
+esp_err_t nvs_open(const char *ns, int, nvs_handle_t *handle) { assert(strcmp(ns,"experiment_cfg")==0);*handle=1;return open_error; }
+esp_err_t nvs_get_blob(nvs_handle_t, const char *key, void *value, size_t *size) {
+    assert(strcmp(key,"tuning_v1")==0);
+    if(committed.empty())return ESP_ERR_NVS_NOT_FOUND;
+    if(*size<committed.size())return ESP_ERR_INVALID_SIZE;
+    *size=committed.size();memcpy(value,committed.data(),*size);return ESP_OK;
+}
+esp_err_t nvs_set_blob(nvs_handle_t, const char *key, const void *value, size_t size) {
+    assert(strcmp(key,"tuning_v1")==0);++writes;
+    if(set_error)return set_error;
+    pending.assign(static_cast<const unsigned char *>(value),static_cast<const unsigned char *>(value)+size);
+    return ESP_OK;
+}
+esp_err_t nvs_commit(nvs_handle_t) { ++commits;if(commit_error)return commit_error;committed=pending;return ESP_OK; }
+void nvs_close(nvs_handle_t) { pending.clear(); }
+
+int main() {
+    assert(runtime_tuning_init()==ESP_ERR_NVS_NOT_FOUND);
+    RuntimeTuning defaults=runtime_tuning_get();assert(defaults.telemetry_hz==50&&defaults.slow_telemetry_hz==10&&defaults.gyro_scale_z==1);
+    RuntimeTuning wanted=defaults;wanted.telemetry_hz=7;wanted.slow_telemetry_hz=3;wanted.gyro_scale_z=1.25f;
+    assert(runtime_tuning_save(wanted)==ESP_OK);
+    assert(runtime_tuning_get().gyro_scale_z==1.25f&&writes==1&&commits==1);
+    assert(runtime_tuning_init()==ESP_OK&&runtime_tuning_get().telemetry_hz==7);
+    for(int which=0;which<3;++which) {
+        RuntimeTuning next=wanted;next.gyro_scale_z=1.5f;
+        open_error=which==0?ESP_FAIL:ESP_OK;set_error=which==1?ESP_FAIL:ESP_OK;commit_error=which==2?ESP_FAIL:ESP_OK;
+        assert(runtime_tuning_save(next)!=ESP_OK);
+        assert(runtime_tuning_get().gyro_scale_z==1.25f);
+    }
+    open_error=set_error=commit_error=ESP_OK;
+    const unsigned before=writes;
+    for(float invalid:{0.0f,-1.0f,0.49f,2.01f,std::numeric_limits<float>::infinity(),std::numeric_limits<float>::quiet_NaN()}) {
+        RuntimeTuning next=wanted;next.gyro_scale_x=invalid;assert(runtime_tuning_save(next)==ESP_ERR_INVALID_ARG);
+    }
+    for(unsigned invalid:{0u,51u,100000u}){RuntimeTuning next=wanted;next.telemetry_hz=invalid;assert(runtime_tuning_save(next)==ESP_ERR_INVALID_ARG);}
+    assert(writes==before);
+    // Corrupt/newer data uses defaults and preserves the original record.
+    RuntimeTuning newer=wanted;newer.schema_version=2;
+    committed.assign(reinterpret_cast<unsigned char *>(&newer),reinterpret_cast<unsigned char *>(&newer)+sizeof(newer));
+    assert(runtime_tuning_init()==ESP_ERR_INVALID_ARG&&runtime_tuning_get().gyro_scale_z==1);
+    assert(committed.size()==sizeof(newer));
+    committed.resize(5);assert(runtime_tuning_init()==ESP_ERR_INVALID_SIZE&&committed.size()==5);
+    // Rates that do not divide 50 Hz retain the requested average without bursts.
+    for(unsigned hz:{1u,3u,7u,10u,49u,50u}){
+        TelemetryGate gate;unsigned count=0;
+        for(int64_t us=0;us<10000000;us+=20000)count+=gate.due(us,hz);
+        assert(std::abs(static_cast<int>(count)-static_cast<int>(hz*10))<=1);
+    }
+    TelemetryGate gate;assert(gate.due(0,5));assert(!gate.due(0,5));assert(!gate.due(199999,5));assert(gate.due(200000,5));
+    assert(gate.due(10000000,5));assert(!gate.due(10000000,5));assert(!gate.due(10000001,5));
+    assert(gate.due(10020000,10));assert(!gate.due(10020000,10));
+    assert(!gate.due(10030000,0));
+}
diff --git a/tests/tuning_http_test.cpp b/tests/tuning_http_test.cpp
new file mode 100644
index 00000000..5daa1f8f
--- /dev/null
+++ b/tests/tuning_http_test.cpp
@@ -0,0 +1,49 @@
+#include "runtime_tuning_http.h"
+#include "runtime_tuning_store.h"
+#include <algorithm>
+#include <cassert>
+#include <cstring>
+#include <string>
+#include <vector>
+static RuntimeTuning current;
+static unsigned saves=0,restarts=0,wifi_saves=0;
+static bool save_failed=false;
+static std::vector<httpd_uri_t> routes;
+static std::string input,output;
+static size_t offset=0,chunk=3;
+static int status=200;
+RuntimeTuning runtime_tuning_get(){return current;}
+esp_err_t runtime_tuning_save(const RuntimeTuning &value){++saves;if(save_failed)return ESP_FAIL;current=value;return ESP_OK;}
+esp_err_t httpd_resp_send_err(httpd_req_t*,int code,const char *text){status=code;output=text;return ESP_OK;}
+esp_err_t httpd_resp_set_type(httpd_req_t*,const char*){return ESP_OK;}
+esp_err_t httpd_resp_set_hdr(httpd_req_t*,const char*,const char*){return ESP_OK;}
+esp_err_t httpd_resp_sendstr(httpd_req_t*,const char *text){output=text;return ESP_OK;}
+int httpd_req_recv(httpd_req_t*,char *dest,size_t size){size_t n=std::min({size,input.size()-offset,chunk});memcpy(dest,input.data()+offset,n);offset+=n;return n;}
+esp_err_t httpd_register_uri_handler(httpd_handle_t,const httpd_uri_t *route){routes.push_back(*route);return ESP_OK;}
+esp_err_t wifi_load_sta_credentials_or_default(char *ssid,size_t,char *password,size_t){strcpy(ssid,"test-network");strcpy(password,"do-not-expose");return ESP_OK;}
+esp_err_t wifi_save_sta_credentials(const char *ssid,const char *password){++wifi_saves;return strlen(ssid)>0&&strlen(ssid)<=32&&(strlen(password)==0||(strlen(password)>=8&&strlen(password)<=63))?ESP_OK:ESP_ERR_INVALID_ARG;}
+esp_err_t esp_wifi_get_ps(int *ps){*ps=0;return ESP_OK;}
+void app_runtime_restart_after_delay_ms(uint32_t ms){assert(ms==1200);++restarts;}
+static void request(const char *path,int method,std::string body=""){
+ input=body;offset=0;status=200;output.clear();httpd_req_t req{body.size()};
+ for(const auto&r:routes)if(strcmp(path,r.uri)==0&&method==r.method){r.handler(&req);return;}
+ assert(false);
+}
+int main(){
+ register_runtime_tuning_http(nullptr);assert(routes.size()==5);
+ request("/api/tuning",HTTP_POST,R"({"telemetry_hz":7,"gyro_scale_z":1.25})");
+ assert(status==200&&saves==1&&current.telemetry_hz==7&&current.gyro_scale_z==1.25f&&current.gyro_scale_x==1);
+ assert(output.find("\"restart\":false")!=std::string::npos);
+ const unsigned old=saves;
+ for(const char *bad:{"{}","[]",R"({"telemetry_hz":1,"telemetry_hz":50})",R"({"telemetry_hz":true})",R"({"telemetry_hz":1.5})",R"({"telemetry_hz":51})",R"({"telemetry_hz":0})",R"({"slow_telemetry_hz":11})",R"({"gyro_scale_z":0.499999999999})",R"({"gyro_scale_x":2.0000000001})",R"({"gyro_scale_x":1e100})",R"({"unused":2})",R"({"telemetry_hz\u0000bad":20})",R"({"telemetry_hz":20} garbage)"}){
+  request("/api/tuning",HTTP_POST,bad);assert(status==400&&saves==old);
+ }
+ request("/api/tuning",HTTP_POST,std::string(513,' '));assert(status==400&&saves==old);
+ save_failed=true;request("/api/tuning",HTTP_POST,R"({"telemetry_hz":10})");assert(status==500&&current.telemetry_hz==7);save_failed=false;
+ request("/api/tuning",HTTP_GET);assert(status==200&&output.find("2026.11.16-runtime1")!=std::string::npos);
+ request("/api/wifi",HTTP_GET);assert(status==200&&output.find("test-network")!=std::string::npos&&output.find("do-not-expose")==std::string::npos);
+ request("/api/wifi",HTTP_POST,R"({"ssid":"target","password":"newpassword"})");assert(status==200&&restarts==1&&wifi_saves==1);
+ request("/api/wifi",HTTP_POST,R"({"ssid":"target"})");assert(status==400&&restarts==1&&wifi_saves==1);
+ request("/api/wifi",HTTP_POST,R"({"ssid":"target","password":"short"})");assert(status==400&&restarts==1);
+ request("/tuning",HTTP_GET);assert(status==200&&output.find("/api/tuning")!=std::string::npos);
+}
