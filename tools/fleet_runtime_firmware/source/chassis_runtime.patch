diff --git a/main/control/motion_safety.h b/main/control/motion_safety.h
new file mode 100644
index 00000000..c8643845
--- /dev/null
+++ b/main/control/motion_safety.h
@@ -0,0 +1,111 @@
+#pragma once
+
+#include "motion_config.h"
+#include "msg/motion_msg.h"
+
+#include <cmath>
+#include <limits>
+
+// Pure helpers shared by the control loop and host regression tests; no RTOS/ROS dependencies.
+namespace motion_safety {
+
+inline bool IsMicroRosVelocity(const MotionMsg& command) {
+    return command.source == MOTION_SRC_MICROROS && command.control_mode == 0;
+}
+
+inline bool MakeMicroRosVelocity(double vx_m_s, double vy_m_s, double wz_rad_s,
+                                uint32_t received_ms, uint32_t sequence,
+                                MotionMsg* output) {
+    const double vx = vx_m_s * 1000.0;
+    const double vy = vy_m_s * 1000.0;
+    const double limit = std::numeric_limits<float>::max();
+    if (output == nullptr || !std::isfinite(vx) || !std::isfinite(vy) ||
+        !std::isfinite(wz_rad_s) || std::fabs(vx) > limit || std::fabs(vy) > limit ||
+        std::fabs(wz_rad_s) > limit) {
+        return false;
+    }
+    MotionMsg command = {};
+    command.source = MOTION_SRC_MICROROS;
+    command.target_vx = static_cast<float>(vx);
+    command.target_vy = static_cast<float>(vy);
+    command.target_wz = static_cast<float>(wz_rad_s);
+    command.cmd_vel_has_command = true;
+    command.cmd_vel_received_ms = received_ms;
+    command.cmd_vel_received_sequence = sequence;
+    *output = command;
+    return true;
+}
+
+inline void ClearVelocityTargets(MotionMsg* command) {
+    command->target_vx = 0.0f;
+    command->target_vy = 0.0f;
+    command->target_wz = 0.0f;
+    command->target_motor_v = 0.0f;
+}
+
+class CmdVelWatchdog {
+public:
+    void Observe(const MotionMsg& command) {
+        if (!IsMicroRosVelocity(command) || !command.cmd_vel_has_command) {
+            return;
+        }
+        has_command_ = true;
+        received_ms_ = command.cmd_vel_received_ms;
+        received_sequence_ = command.cmd_vel_received_sequence;
+        timed_out_ = false;
+    }
+
+    void Update(uint32_t now_ms) {
+        // Once expired, keep the lease expired through the 32-bit uptime wrap.
+        if (has_command_ && AgeMs(now_ms) >= leap_config::motion::kMicroRosCommandTimeoutMs) {
+            timed_out_ = true;
+        }
+    }
+
+    bool CanApply(const MotionMsg& command, uint32_t now_ms) const {
+        if (!IsMicroRosVelocity(command)) {
+            return true;
+        }
+        return command.cmd_vel_has_command && has_command_ && !timed_out_ &&
+               command.cmd_vel_received_sequence == received_sequence_ &&
+               static_cast<uint32_t>(now_ms - command.cmd_vel_received_ms) <
+                   leap_config::motion::kMicroRosCommandTimeoutMs;
+    }
+
+    void MarkApplied(const MotionMsg& command) {
+        if (IsMicroRosVelocity(command)) {
+            applied_sequence_ = command.cmd_vel_received_sequence;
+        }
+    }
+
+    uint32_t AgeMs(uint32_t now_ms) const {
+        return static_cast<uint32_t>(now_ms - received_ms_);
+    }
+
+    void WriteStatus(MotionMsg* status) const {
+        status->cmd_vel_has_command = has_command_;
+        status->cmd_vel_received_ms = received_ms_;
+        status->cmd_vel_received_sequence = received_sequence_;
+        status->cmd_vel_applied_sequence = applied_sequence_;
+        status->cmd_vel_timed_out = timed_out_;
+    }
+
+private:
+    bool has_command_ = false;
+    bool timed_out_ = false;
+    uint32_t received_ms_ = 0;
+    uint32_t received_sequence_ = 0;
+    uint32_t applied_sequence_ = 0;
+};
+
+inline float FilterWheelRpm(float raw_rpm, float previous_rpm) {
+    const float filtered = leap_config::motion::kVelocityFilterAlpha * raw_rpm +
+        (1.0f - leap_config::motion::kVelocityFilterAlpha) * previous_rpm;
+    // A float IIR otherwise remains at denorm_min forever with zero encoder input.
+    if (raw_rpm == 0.0f && std::fabs(filtered) < leap_config::motion::kVelocityZeroThresholdRpm) {
+        return 0.0f;
+    }
+    return filtered;
+}
+
+}  // namespace motion_safety
diff --git a/main/tasks/network/provision/runtime_tuning_http.cpp b/main/tasks/network/provision/runtime_tuning_http.cpp
new file mode 100644
index 00000000..fe766392
--- /dev/null
+++ b/main/tasks/network/provision/runtime_tuning_http.cpp
@@ -0,0 +1,153 @@
+#include "runtime_tuning_http.h"
+#include "runtime_tuning_store.h"
+#include "firmware_version.h"
+#include "wifi_app.h"
+#include "app_runtime.h"
+#include "cJSON.h"
+#include "esp_app_desc.h"
+#include "esp_wifi.h"
+#include <cmath>
+#include <cstring>
+#include <cstdlib>
+
+static esp_err_t send_json(httpd_req_t *req, cJSON *root) {
+    if (!root) return httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "allocation failed");
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) return httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "allocation failed");
+    httpd_resp_set_type(req, "application/json");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    esp_err_t err = httpd_resp_sendstr(req, body);
+    cJSON_free(body);
+    return err;
+}
+
+static cJSON *read_json(httpd_req_t *req) {
+    if (req->content_len < 2 || req->content_len > 512) return nullptr;
+    char body[513] = {};
+    size_t received = 0;
+    int timeouts = 0;
+    while (received < req->content_len) {
+        const int n = httpd_req_recv(req, body + received, req->content_len - received);
+        if (n == HTTPD_SOCK_ERR_TIMEOUT && ++timeouts <= 3) continue;
+        if (n <= 0) return nullptr;
+        received += n;
+    }
+    if (memchr(body, '\0', received) != nullptr || strstr(body, "\\u0000") != nullptr) return nullptr;
+    cJSON *root = cJSON_ParseWithLengthOpts(body, received + 1, nullptr, true);
+    if (!cJSON_IsObject(root)) { cJSON_Delete(root); return nullptr; }
+    // Duplicate keys make a command ambiguous. Reject them before any NVS write.
+    for (const cJSON *a = root->child; a; a = a->next) {
+        for (const cJSON *b = a->next; b; b = b->next) {
+            if (strcmp(a->string, b->string) == 0) { cJSON_Delete(root); return nullptr; }
+        }
+    }
+    return root;
+}
+
+static cJSON *tuning_json() {
+    const RuntimeTuning value = runtime_tuning_get();
+    cJSON *root = cJSON_CreateObject();
+    if (!root) return nullptr;
+    cJSON_AddNumberToObject(root, "schema_version", value.schema_version);
+    cJSON_AddNumberToObject(root, "telemetry_hz", value.telemetry_hz);
+    cJSON_AddNumberToObject(root, "slow_telemetry_hz", value.slow_telemetry_hz);
+    cJSON_AddNumberToObject(root, "gyro_scale_x", value.gyro_scale_x);
+    cJSON_AddNumberToObject(root, "gyro_scale_y", value.gyro_scale_y);
+    cJSON_AddNumberToObject(root, "gyro_scale_z", value.gyro_scale_z);
+    cJSON_AddStringToObject(root, "firmware_version", leap_config::firmware::kVersion);
+    return root;
+}
+
+static esp_err_t tuning_get(httpd_req_t *req) { return send_json(req, tuning_json()); }
+
+static esp_err_t tuning_post(httpd_req_t *req) {
+    cJSON *root = read_json(req);
+    if (!root) return httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "invalid JSON object");
+    RuntimeTuning next = runtime_tuning_get();
+    bool valid = root->child != nullptr;
+    for (cJSON *item = root->child; item && valid; item = item->next) {
+        if (!cJSON_IsNumber(item) || !std::isfinite(item->valuedouble)) { valid = false; break; }
+        const double n = item->valuedouble;
+        if (strcmp(item->string, "telemetry_hz") == 0) {
+            valid = n >= 1 && n <= 50 && n == std::floor(n);
+            if (valid) next.telemetry_hz = static_cast<uint32_t>(n);
+        } else if (strcmp(item->string, "slow_telemetry_hz") == 0) {
+            valid = n >= 1 && n <= 10 && n == std::floor(n);
+            if (valid) next.slow_telemetry_hz = static_cast<uint32_t>(n);
+        } else if (strcmp(item->string, "gyro_scale_x") == 0) { valid = n >= 0.5 && n <= 2.0; if (valid) next.gyro_scale_x = static_cast<float>(n); }
+        else if (strcmp(item->string, "gyro_scale_y") == 0) { valid = n >= 0.5 && n <= 2.0; if (valid) next.gyro_scale_y = static_cast<float>(n); }
+        else if (strcmp(item->string, "gyro_scale_z") == 0) { valid = n >= 0.5 && n <= 2.0; if (valid) next.gyro_scale_z = static_cast<float>(n); }
+        else valid = false;
+    }
+    cJSON_Delete(root);
+    if (!valid || !runtime_tuning_valid(next)) return httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "unknown field or value out of range");
+    if (runtime_tuning_save(next) != ESP_OK) return httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "NVS save failed; live tuning unchanged");
+    cJSON *response = tuning_json();
+    if (response) { cJSON_AddBoolToObject(response, "saved", true); cJSON_AddBoolToObject(response, "restart", false); }
+    return send_json(req, response);
+}
+
+static esp_err_t wifi_get(httpd_req_t *req) {
+    char ssid[33] = {}, password[65] = {};
+    const esp_err_t err = wifi_load_sta_credentials_or_default(ssid, sizeof(ssid), password, sizeof(password));
+    cJSON *root = cJSON_CreateObject();
+    if (root) {
+        cJSON_AddStringToObject(root, "ssid", err == ESP_OK ? ssid : "");
+        cJSON_AddBoolToObject(root, "password_set", password[0] != '\0');
+        wifi_ps_type_t ps;
+        if (esp_wifi_get_ps(&ps) == ESP_OK) cJSON_AddNumberToObject(root, "power_save", ps);
+        else cJSON_AddNullToObject(root, "power_save");
+    }
+    memset(password, 0, sizeof(password));
+    return send_json(req, root);
+}
+
+static esp_err_t wifi_post(httpd_req_t *req) {
+    cJSON *root = read_json(req);
+    if (!root) return httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "invalid JSON object");
+    cJSON *ssid = cJSON_GetObjectItemCaseSensitive(root, "ssid");
+    cJSON *password = cJSON_GetObjectItemCaseSensitive(root, "password");
+    bool valid = cJSON_IsString(ssid) && cJSON_IsString(password);
+    for (cJSON *item = root->child; item; item = item->next) {
+        if (strcmp(item->string, "ssid") != 0 && strcmp(item->string, "password") != 0) valid = false;
+    }
+    esp_err_t result = ESP_ERR_INVALID_ARG;
+    if (valid) result = wifi_save_sta_credentials(ssid->valuestring, password->valuestring);
+    cJSON_Delete(root);
+    if (result == ESP_ERR_INVALID_ARG) return httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "ssid: 1..32 bytes; password: empty or 8..63 bytes; both required");
+    if (result != ESP_OK) return httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "NVS save failed");
+    httpd_resp_set_type(req, "application/json");
+    const esp_err_t sent = httpd_resp_sendstr(req, "{\"saved\":true,\"restart\":true,\"delay_ms\":1200}");
+    app_runtime_restart_after_delay_ms(1200);
+    return sent;
+}
+
+static constexpr const char *kTuningPage = R"HTML(<!doctype html><html lang="zh"><meta charset="utf-8"><title>底盘实验参数</title>
+<style>body{font:16px sans-serif;max-width:700px;margin:30px auto}label{display:block;margin:14px 0}input{float:right;width:130px}pre{white-space:pre-wrap}</style>
+<h1>底盘实验参数</h1><p>保存后立即生效并写入 NVS；运动控制和 IMU 采样周期保持 20 ms。</p>
+<form id="settings"><label>快遥测 Hz（1–50）<input name="telemetry_hz" type="number" min="1" max="50" step="1" required></label>
+<label>慢遥测 Hz（1–10）<input name="slow_telemetry_hz" type="number" min="1" max="10" step="1" required></label>
+<label>陀螺 X 比例（0.5–2）<input name="gyro_scale_x" type="number" min="0.5" max="2" step="0.0001" required></label>
+<label>陀螺 Y 比例（0.5–2）<input name="gyro_scale_y" type="number" min="0.5" max="2" step="0.0001" required></label>
+<label>陀螺 Z 比例（0.5–2）<input name="gyro_scale_z" type="number" min="0.5" max="2" step="0.0001" required></label>
+<button type="submit" disabled>保存并应用</button></form><pre id="result"></pre>
+<p>micro-ROS 快组：odom、imu；慢组：scan、battery_state、ultrasonic。发布速率受网络和传感器产出限制。</p>
+<p>陀螺比例在去除零偏后、姿态积分前应用。切换比例不重置已累计姿态。</p><a href="/">返回状态与 Wi-Fi 配网页</a>
+<script>
+const form=document.getElementById('settings'),result=document.getElementById('result');
+async function load(){try{const r=await fetch('/api/tuning',{cache:'no-store'});if(!r.ok)throw new Error(await r.text());const j=await r.json();for(const e of form.elements)if(e.name)e.value=j[e.name];result.textContent='固件：'+j.firmware_version;form.querySelector('button').disabled=false;}catch(e){result.textContent=e.message;}}
+form.onsubmit=async e=>{e.preventDefault();const j={};for(const el of form.elements)if(el.name)j[el.name]=Number(el.value);try{const r=await fetch('/api/tuning',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(j)});const text=await r.text();result.textContent=(r.ok?'已保存：':'保存失败：')+text;}catch(err){result.textContent=err.message;}};load();
+</script></html>)HTML";
+static esp_err_t tuning_page(httpd_req_t *req) { httpd_resp_set_type(req, "text/html; charset=utf-8"); return httpd_resp_sendstr(req, kTuningPage); }
+
+void register_runtime_tuning_http(httpd_handle_t server) {
+    const httpd_uri_t routes[] = {
+        {.uri="/api/tuning", .method=HTTP_GET, .handler=tuning_get, .user_ctx=nullptr},
+        {.uri="/api/tuning", .method=HTTP_POST, .handler=tuning_post, .user_ctx=nullptr},
+        {.uri="/api/wifi", .method=HTTP_GET, .handler=wifi_get, .user_ctx=nullptr},
+        {.uri="/api/wifi", .method=HTTP_POST, .handler=wifi_post, .user_ctx=nullptr},
+        {.uri="/tuning", .method=HTTP_GET, .handler=tuning_page, .user_ctx=nullptr},
+    };
+    for (const auto &route : routes) ESP_ERROR_CHECK(httpd_register_uri_handler(server, &route));
+}
