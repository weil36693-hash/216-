--- /dev/null
+++ b/tests/imu_scale_test.cpp
@@ -0,0 +1,28 @@
+#include "lsm6ds3_driver.h"
+#include <cassert>
+#include <cmath>
+#include <cstdint>
+static int64_t now_us=1000000;
+static int16_t raw[6]={100,200,-100,0,0,16384};
+static int writes=0,reg=0,read_offset=0;
+static bool fail_read=false;
+int64_t esp_timer_get_time(){return now_us;}
+void vTaskDelay(int ms){now_us+=ms*1000;}
+i2c_cmd_handle_t i2c_cmd_link_create(){writes=0;read_offset=0;return reinterpret_cast<void*>(1);}
+void i2c_master_write_byte(i2c_cmd_handle_t,uint8_t value,bool){if(++writes==2)reg=value;}
+void i2c_master_read(i2c_cmd_handle_t,uint8_t *dest,size_t n,int){
+ for(size_t i=0;i<n;++i){if(reg==0x0f)dest[i]=0x6a;else{const uint16_t value=static_cast<uint16_t>(raw[read_offset/2]);dest[i]=(read_offset%2)?value>>8:value&255;}++read_offset;}}
+void i2c_master_read_byte(i2c_cmd_handle_t cmd,uint8_t *dest,int ack){i2c_master_read(cmd,dest,1,ack);}
+esp_err_t i2c_master_cmd_begin(int,i2c_cmd_handle_t,int){return fail_read?ESP_FAIL:ESP_OK;}
+static bool near(float a,float b){return std::abs(a-b)<0.0002f;}
+int main(){
+ Lsm6ds3Imu imu(0,4,5);assert(imu.Init());
+ raw[0]=1100;raw[1]=-800;raw[2]=900;now_us+=20000;
+ assert(imu.Update(0.5f,1.5f,2.0f)==ESP_OK);
+ assert(near(imu.GetGyroX(),4.375f));assert(near(imu.GetGyroY(),-13.125f));assert(near(imu.GetGyroZ(),17.5f));
+ assert(near(imu.GetYaw(),0.35f)); // scale affects integration, not only telemetry
+ assert(near(imu.GetAccZ(),16384*0.061f/1000));
+ now_us+=20000;assert(imu.Update()==ESP_OK);assert(near(imu.GetGyroZ(),8.75f));assert(near(imu.GetYaw(),0.525f));
+ float w,x,y,z;imu.GetQuaternion(w,x,y,z);assert(near(w*w+x*x+y*y+z*z,1.0f));
+ fail_read=true;assert(imu.Update(2,2,2)==ESP_FAIL);assert(near(imu.GetYaw(),0.525f));
+}
