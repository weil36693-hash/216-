diff --git a/tests/motion_safety_test.cpp b/tests/motion_safety_test.cpp
new file mode 100644
index 00000000..2e49463f
--- /dev/null
+++ b/tests/motion_safety_test.cpp
@@ -0,0 +1,123 @@
+#include "motion_safety.h"
+#include "differential_kinematics.h"
+
+#include <cassert>
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+
+namespace {
+MotionMsg Velocity(uint32_t now, uint32_t sequence = 1) {
+    MotionMsg command;
+    assert(motion_safety::MakeMicroRosVelocity(0.25, -0.01, -0.7, now, sequence, &command));
+    return command;
+}
+
+void TestInputsAndUnits() {
+    auto command = Velocity(123, 4);
+    assert(command.source == MOTION_SRC_MICROROS && command.control_mode == 0);
+    assert(command.target_vx == 250.0f && command.target_vy == -10.0f);
+    assert(std::fabs(command.target_wz + 0.7f) < 1e-6f);
+    assert(command.cmd_vel_has_command && command.cmd_vel_received_ms == 123);
+    assert(command.cmd_vel_received_sequence == 4);
+    const double invalid[] = {std::numeric_limits<double>::quiet_NaN(),
+        std::numeric_limits<double>::infinity(), -std::numeric_limits<double>::infinity(),
+        std::numeric_limits<double>::max()};
+    for (double value : invalid) {
+        assert(!motion_safety::MakeMicroRosVelocity(value, 0, 0, 1, 5, &command));
+        assert(!motion_safety::MakeMicroRosVelocity(0, value, 0, 1, 5, &command));
+        assert(!motion_safety::MakeMicroRosVelocity(0, 0, value, 1, 5, &command));
+        assert(command.cmd_vel_received_sequence == 4);  // Rejection does not renew a lease.
+    }
+    assert(!motion_safety::MakeMicroRosVelocity(0, 0, 0, 0, 0, nullptr));
+}
+
+void TestLeaseAndHandover() {
+    motion_safety::CmdVelWatchdog watchdog;
+    auto command = Velocity(1000);
+    assert(!watchdog.CanApply(command, 1000));
+    watchdog.Observe(command);
+    watchdog.Update(1499);
+    assert(watchdog.CanApply(command, 1499));
+    watchdog.MarkApplied(command);
+    watchdog.Update(1500);
+    assert(!watchdog.CanApply(command, 1500));
+    // Cached navigation must not resume after a long gamepad override, or after uptime wraps.
+    assert(!watchdog.CanApply(command, 1001));
+    MotionMsg gamepad;
+    gamepad.source = MOTION_SRC_GAMEPAD;
+    assert(watchdog.CanApply(gamepad, 3000));
+    watchdog.Observe(gamepad);  // Other sources cannot renew the micro-ROS lease.
+    MotionMsg status;
+    watchdog.WriteStatus(&status);
+    assert(status.cmd_vel_timed_out && status.cmd_vel_received_sequence == 1);
+    assert(status.cmd_vel_applied_sequence == 1);
+    command = Velocity(4000, 2);
+    watchdog.Observe(command);
+    watchdog.Update(4000);
+    assert(watchdog.CanApply(command, 4000));
+    watchdog.WriteStatus(&status);
+    assert(!status.cmd_vel_timed_out && status.cmd_vel_received_sequence == 2);
+    assert(status.cmd_vel_applied_sequence == 1); // Receipt is distinct from application.
+    watchdog.MarkApplied(command);
+    watchdog.WriteStatus(&status);
+    assert(status.cmd_vel_applied_sequence == 2);
+    auto missing_receipt = command;
+    missing_receipt.cmd_vel_has_command = false;
+    assert(!watchdog.CanApply(missing_receipt, 4000));
+    auto stale_sequence = Velocity(4000, 1);
+    assert(!watchdog.CanApply(stale_sequence, 4000));
+    auto position = command;
+    position.control_mode = 1;
+    assert(watchdog.CanApply(position, 5000));
+    motion_safety::ClearVelocityTargets(&command);
+    assert(command.target_vx == 0 && command.target_vy == 0 && command.target_wz == 0);
+}
+
+void TestUptimeWrap() {
+    motion_safety::CmdVelWatchdog watchdog;
+    const uint32_t received = std::numeric_limits<uint32_t>::max() - 100;
+    auto command = Velocity(received, std::numeric_limits<uint32_t>::max());
+    watchdog.Observe(command);
+    watchdog.Update(398);  // 499 ms since reception, across uptime wrap.
+    assert(watchdog.AgeMs(398) == 499 && watchdog.CanApply(command, 398));
+    watchdog.Update(399);
+    assert(watchdog.AgeMs(399) == 500 && !watchdog.CanApply(command, 399));
+    command = Velocity(500, 0);  // Local sequence wrap is allowed; validity is explicit.
+    watchdog.Observe(command);
+    assert(watchdog.CanApply(command, 500));
+}
+
+void TestWheelFilterAndRosConversion() {
+    for (float initial : {1.0f, -1.0f, 100.0f, -100.0f}) {
+        float rpm = initial;
+        for (int i = 0; i < 1000; ++i) rpm = motion_safety::FilterWheelRpm(0, rpm);
+        assert(rpm == 0.0f && !std::signbit(rpm));
+        float wheels[2] = {rpm * leap_config::motion::kRpmToMmS, rpm};
+        float vx, vy, wz;
+        DifferentialKinematics{}.Forward(wheels, &vx, &vy, &wz);
+        assert(static_cast<double>(vx) / 1000.0 == 0.0 && wz == 0.0f);
+    }
+    // A real encoder input, even below the tail threshold, must never be discarded.
+    const float small = leap_config::motion::kVelocityZeroThresholdRpm / 2;
+    assert(motion_safety::FilterWheelRpm(small, 0) > 0);
+    assert(motion_safety::FilterWheelRpm(0, 1.0f) > 0.6f);
+    assert(motion_safety::FilterWheelRpm(0, std::numeric_limits<float>::denorm_min()) == 0);
+    // Exercise actual kinematics and numeric float-to-ROS-double conversion at a useful speed.
+    float wheels[2], vx, vy, wz;
+    DifferentialKinematics kinematics;
+    kinematics.Inverse(250, 0, 0.7f, wheels);
+    kinematics.Forward(wheels, &vx, &vy, &wz);
+    assert(std::fabs(static_cast<double>(vx) / 1000.0 - 0.25) < 1e-6);
+    assert(std::fabs(static_cast<double>(wz) - 0.7) < 1e-6);
+}
+}  // namespace
+
+int main() {
+    TestInputsAndUnits();
+    TestLeaseAndHandover();
+    TestUptimeWrap();
+    TestWheelFilterAndRosConversion();
+    std::cout << "motion safety: input conversion, lease, handover, wrap, zero tail passed\n";
+}
