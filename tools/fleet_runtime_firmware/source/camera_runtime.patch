index 0000000..0fe923b
--- /dev/null
+++ b/tests/test_settings_json.c
@@ -0,0 +1,25 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../main/camera_settings_json.h"
+static bool patch(const char *text,camera_settings_t *s) {
+    cJSON *json=cJSON_Parse(text);bool okay=camera_settings_patch(s,json);cJSON_Delete(json);return okay;
+}
+int main(void) {
+    const char raw_nul[]="{\"fps\":5}\0{\"bad\":0}";
+    const char encoded_nul[]="{\"ssid\":\"a\\u0000b\"}";
+    assert(!camera_json_body_valid(raw_nul,sizeof(raw_nul)-1));
+    assert(!camera_json_body_valid(encoded_nul,sizeof(encoded_nul)-1));
+    assert(camera_json_body_valid("{\"fps\":5}",9));
+    assert(!camera_json_body_valid(NULL,0));
+    camera_settings_t settings;camera_settings_defaults(&settings);
+    assert(patch("{\"fps\":10,\"auto_gain\":false,\"gain\":15,\"resolution\":\"320x240\"}",&settings));
+    assert(settings.fps==10&&settings.auto_gain==0&&settings.gain==15&&settings.resolution==1);
+    const char *bad[]={"{\"fps\":0}","{\"fps\":2.5}","{\"fps\":\"5\"}","{\"auto_gain\":1}",
+        "{\"unknown\":1}","{\"resolution\":\"999x999\"}","{\"fps\":5,\"fps\":10}","[]","null","{\"fps\":1e100}",
+        "{\"auto_white_balance\":false}","{\"white_balance_mode\":3}"};
+    for(size_t i=0;i<sizeof(bad)/sizeof(bad[0]);i++){camera_settings_defaults(&settings);assert(!patch(bad[i],&settings));}
+    camera_settings_defaults(&settings);
+    assert(patch("{\"auto_white_balance\":false,\"white_balance_mode\":3}",&settings));
+    assert(patch("{\"auto_white_balance\":true,\"white_balance_mode\":0}",&settings));
+    puts("PASS: JSON partial updates, type/range/unknown/duplicate rejection and WB mode consistency");
+}
