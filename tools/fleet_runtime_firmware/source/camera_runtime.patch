new file mode 100644
index 0000000..97563b9
--- /dev/null
+++ b/main/camera_settings.c
@@ -0,0 +1,56 @@
+#include "camera_settings.h"
+#include <string.h>
+#ifdef ESP_PLATFORM
+#include "sdkconfig.h"
+#else
+#define CONFIG_CAMERA_STREAM_FPS 5
+#endif
+const char *const camera_resolution_names[] = {
+    "160x120", "320x240", "640x480", "800x600", "1024x768", "1280x1024", "1600x1200"
+};
+void camera_settings_defaults(camera_settings_t *s)
+{
+    *s = (camera_settings_t){.schema=CAMERA_SETTINGS_SCHEMA, .fps=CONFIG_CAMERA_STREAM_FPS, .jpeg_quality=12,
+        .resolution=2, .auto_exposure=1, .exposure=300, .exposure_level=0,
+        .auto_white_balance=1, .white_balance_mode=0, .auto_gain=1, .gain=0};
+}
+static bool boolean(int32_t n) { return n == 0 || n == 1; }
+bool camera_settings_valid(const camera_settings_t *s)
+{
+    return s && s->schema == CAMERA_SETTINGS_SCHEMA && s->fps >= 1 && s->fps <= 30 &&
+        s->jpeg_quality >= 4 && s->jpeg_quality <= 63 && s->resolution >= 0 &&
+        s->resolution < CAMERA_RESOLUTION_COUNT && boolean(s->auto_exposure) &&
+        s->exposure >= 0 && s->exposure <= 1200 && s->exposure_level >= -2 &&
+        s->exposure_level <= 2 && boolean(s->auto_white_balance) &&
+        s->white_balance_mode >= 0 && s->white_balance_mode <= 4 &&
+        ((s->auto_white_balance && s->white_balance_mode == 0) ||
+         (!s->auto_white_balance && s->white_balance_mode >= 1)) &&
+        boolean(s->auto_gain) && s->gain >= 0 && s->gain <= 30;
+}
+int camera_resolution_index(const char *name)
+{
+    if (!name) return -1;
+    for (int i=0; i<CAMERA_RESOLUTION_COUNT; i++)
+        if (!strcmp(name,camera_resolution_names[i])) return i;
+    return -1;
+}
+
+bool camera_settings_transaction(camera_settings_t *current,const camera_settings_t *next,
+    bool *sensor_consistent,bool *persisted,camera_settings_io_fn apply,
+    camera_settings_io_fn save,void *context)
+{
+    if (!camera_settings_valid(next) || !apply || !save) return false;
+    if (!apply(next,context)) {
+        *sensor_consistent=apply(current,context);
+        return false;
+    }
+    if (!save(next,context)) {
+        *sensor_consistent=apply(current,context);
+        *persisted=save(current,context);
+        return false;
+    }
+    *current=*next;
+    *sensor_consistent=true;
+    *persisted=true;
+    return true;
+}
