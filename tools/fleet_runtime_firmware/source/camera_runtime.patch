@@ -0,0 +1,26 @@
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    uint32_t schema;
+    int32_t fps, jpeg_quality, resolution;
+    int32_t auto_exposure, exposure, exposure_level;
+    int32_t auto_white_balance, white_balance_mode;
+    int32_t auto_gain, gain;
+} camera_settings_t;
+
+#define CAMERA_SETTINGS_SCHEMA 1
+#define CAMERA_RESOLUTION_COUNT 7
+extern const char *const camera_resolution_names[CAMERA_RESOLUTION_COUNT];
+void camera_settings_defaults(camera_settings_t *settings);
+bool camera_settings_valid(const camera_settings_t *settings);
+int camera_resolution_index(const char *name);
+
+typedef bool (*camera_settings_io_fn)(const camera_settings_t *settings,void *context);
+// Keep the published settings unchanged until sensor apply and NVS save succeed.
+// A failed apply restores sensor state; failed persistence also rewrites old NVS.
+bool camera_settings_transaction(camera_settings_t *current,const camera_settings_t *next,
+    bool *sensor_consistent,bool *persisted,camera_settings_io_fn apply,
+    camera_settings_io_fn save,void *context);
diff --git a/main/camera_settings_json.c b/main/camera_settings_json.c
new file mode 100644
index 0000000..8585813
--- /dev/null
+++ b/main/camera_settings_json.c
@@ -0,0 +1,37 @@
+#include "camera_settings_json.h"
+#include <math.h>
+#include <string.h>
+bool camera_settings_patch(camera_settings_t *next,const cJSON *json)
+{
+    if (!cJSON_IsObject(json) || !next) return false;
+    const cJSON *a,*b;
+    cJSON_ArrayForEach(a,json) for(b=a->next;b;b=b->next)
+        if(!strcmp(a->string,b->string))return false;
+    const cJSON *item;
+    cJSON_ArrayForEach(item,json) {
+        const char *key=item->string;
+#define NUMBER(name) if(!strcmp(key,#name)) {if(!cJSON_IsNumber(item)||!isfinite(item->valuedouble)||floor(item->valuedouble)!=item->valuedouble||fabs(item->valuedouble)>100000)return false;next->name=(int32_t)item->valuedouble;continue;}
+#define BOOL(name) if(!strcmp(key,#name)) {if(!cJSON_IsBool(item))return false;next->name=cJSON_IsTrue(item);continue;}
+        NUMBER(fps);NUMBER(jpeg_quality);NUMBER(exposure);NUMBER(exposure_level);
+        NUMBER(white_balance_mode);NUMBER(gain);
+        BOOL(auto_exposure);BOOL(auto_white_balance);BOOL(auto_gain);
+#undef BOOL
+#undef NUMBER
+        if(!strcmp(key,"resolution")) {
+            if(!cJSON_IsString(item))return false;
+            next->resolution=camera_resolution_index(item->valuestring);continue;
+        }
+        return false;
+    }
+    return camera_settings_valid(next);
+}
+
+bool camera_json_body_valid(const char *body,size_t length)
+{
+    if (!body || !length || memchr(body,0,length)) return false;
+    // cJSON represents strings with C NUL terminators; reject embedded NULs
+    // instead of silently truncating Wi-Fi names or accepting a hidden suffix.
+    for(size_t i=0;i+6<=length;i++)
+        if(!memcmp(body+i,"\\u0000",6))return false;
+    return true;
+}
