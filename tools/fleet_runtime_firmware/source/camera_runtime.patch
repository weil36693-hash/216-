diff --git a/main/camera_runtime.c b/main/camera_runtime.c
new file mode 100644
index 0000000..54942c3
--- /dev/null
+++ b/main/camera_runtime.c
@@ -0,0 +1,326 @@
+#include "camera_runtime.h"
+#include "camera_settings.h"
+#include "camera_settings_json.h"
+#include "wifi_manager.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+#include "cJSON.h"
+#include "esp_app_desc.h"
+#include "esp_camera.h"
+#include "esp_log.h"
+#include "esp_netif_sntp.h"
+#include "esp_sntp.h"
+#include "esp_system.h"
+#include "esp_timer.h"
+#include "esp_wifi.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include "nvs.h"
+
+static const char *TAG="CAM_RUNTIME";
+static SemaphoreHandle_t s_lock;
+static camera_settings_t s_settings;
+static bool s_sensor_consistent;
+static bool s_persisted;
+static bool s_sntp_started;
+static int64_t s_last_sync_us;
+static int64_t s_last_sync_monotonic_us;
+static portMUX_TYPE s_time_mux=portMUX_INITIALIZER_UNLOCKED;
+static const framesize_t s_framesizes[]={FRAMESIZE_QQVGA,FRAMESIZE_QVGA,FRAMESIZE_VGA,
+    FRAMESIZE_SVGA,FRAMESIZE_XGA,FRAMESIZE_SXGA,FRAMESIZE_UXGA};
+
+bool camera_runtime_lock(uint32_t timeout_ms)
+{
+    return s_lock && xSemaphoreTake(s_lock,pdMS_TO_TICKS(timeout_ms)) == pdTRUE;
+}
+void camera_runtime_unlock(void) { xSemaphoreGive(s_lock); }
+// Aligned 32-bit values are atomically accessed on ESP32-S3. Streaming reads FPS
+// under s_lock; the HTTP handler also reads/writes under that same mutex.
+int camera_runtime_get_fps(void) { return s_settings.fps; }
+bool camera_runtime_stream_ready(void) { return s_sensor_consistent; }
+
+static esp_err_t apply_sensor(const camera_settings_t *s)
+{
+    sensor_t *sensor=esp_camera_sensor_get();
+    if (!sensor || !camera_settings_valid(s)) return ESP_ERR_INVALID_ARG;
+    camera_sensor_info_t *info=esp_camera_sensor_get_info(&sensor->id);
+    if (!info || s_framesizes[s->resolution] > info->max_size) return ESP_ERR_NOT_SUPPORTED;
+    // The camera is initialized at UXGA with explicit 1 MiB JPEG buffers.
+    // Very large compressed frames still rely on the driver overflow guard.
+    // This function runs only while no stream owns a fb.
+#define SET(call) do { if ((call) != 0) return ESP_FAIL; } while (0)
+    SET(sensor->set_framesize(sensor,s_framesizes[s->resolution]));
+    SET(sensor->set_quality(sensor,s->jpeg_quality));
+    SET(sensor->set_exposure_ctrl(sensor,s->auto_exposure));
+    SET(sensor->set_aec2(sensor,0));
+    SET(sensor->set_ae_level(sensor,s->exposure_level));
+    if (!s->auto_exposure) SET(sensor->set_aec_value(sensor,s->exposure));
+    SET(sensor->set_whitebal(sensor,s->auto_white_balance));
+    SET(sensor->set_wb_mode(sensor,s->white_balance_mode));
+    SET(sensor->set_gain_ctrl(sensor,s->auto_gain));
+    if (!s->auto_gain) SET(sensor->set_agc_gain(sensor,s->gain));
+#undef SET
+    // Drain queued frames after changing registers; no client can send frames
+    // acquired during a sensor reconfiguration while this mutex is held.
+    for (int i=0;i<3;i++) {
+        camera_fb_t *fb=esp_camera_fb_get();
+        if (!fb) return ESP_FAIL;
+        esp_camera_fb_return(fb);
+    }
+    return ESP_OK;
+}
+
+static esp_err_t save_settings(const camera_settings_t *settings)
+{
+    nvs_handle_t handle;
+    esp_err_t err=nvs_open("cam_runtime",NVS_READWRITE,&handle);
+    if (err != ESP_OK) return err;
+    err=nvs_set_blob(handle,"settings_v1",settings,sizeof(*settings));
+    if (err == ESP_OK) err=nvs_commit(handle);
+    nvs_close(handle);
+    return err;
+}
+
+static bool apply_settings_io(const camera_settings_t *settings,void *context)
+{
+    (void)context;
+    esp_err_t err=apply_sensor(settings);
+    if(err!=ESP_OK) ESP_LOGE(TAG,"Sensor apply failed: %s",esp_err_to_name(err));
+    return err==ESP_OK;
+}
+static bool save_settings_io(const camera_settings_t *settings,void *context)
+{
+    (void)context;
+    esp_err_t err=save_settings(settings);
+    if(err!=ESP_OK) ESP_LOGE(TAG,"NVS save failed: %s",esp_err_to_name(err));
+    return err==ESP_OK;
+}
+esp_err_t camera_runtime_init(void)
+{
+    s_lock=xSemaphoreCreateMutex();
+    if (!s_lock) return ESP_ERR_NO_MEM;
+    camera_settings_defaults(&s_settings);
+    nvs_handle_t handle;
+    esp_err_t err=nvs_open("cam_runtime",NVS_READONLY,&handle);
+    if (err == ESP_OK) {
+        camera_settings_t stored={0};
+        size_t length=sizeof(stored);
+        err=nvs_get_blob(handle,"settings_v1",&stored,&length);
+        nvs_close(handle);
+        if (err == ESP_OK && length == sizeof(stored) && camera_settings_valid(&stored)) {
+            s_settings=stored;
+            s_persisted=true;
+        } else if (err != ESP_ERR_NVS_NOT_FOUND) {
+            ESP_LOGE(TAG,"Saved camera settings invalid; using defaults without erasing NVS");
+        }
+    } else if (err != ESP_ERR_NVS_NOT_FOUND) {
+        ESP_LOGE(TAG,"Cannot read camera settings: %s",esp_err_to_name(err));
+        return err;
+    }
+    err=apply_sensor(&s_settings);
+    if (err != ESP_OK) return err;
+    s_sensor_consistent=true;
+    ESP_LOGI(TAG,"Firmware %s; runtime camera settings enabled",CAMERA_FIRMWARE_VERSION);
+    return ESP_OK;
+}
+
+static void time_synced(struct timeval *tv)
+{
+    portENTER_CRITICAL(&s_time_mux);
+    s_last_sync_us=(int64_t)tv->tv_sec*1000000+tv->tv_usec;
+    s_last_sync_monotonic_us=esp_timer_get_time();
+    portEXIT_CRITICAL(&s_time_mux);
+}
+void camera_runtime_time_start(void)
+{
+    if (s_sntp_started) return;
+    esp_sntp_config_t config=ESP_NETIF_SNTP_DEFAULT_CONFIG(CAMERA_SNTP_SERVER);
+    config.sync_cb=time_synced;
+    config.server_from_dhcp=false;
+    esp_sntp_set_sync_interval(60000);
+    esp_err_t err=esp_netif_sntp_init(&config);
+    if (err == ESP_OK) s_sntp_started=true;
+    else ESP_LOGE(TAG,"SNTP start failed: %s",esp_err_to_name(err));
+}
+
+static cJSON *settings_json(void)
+{
+    cJSON *o=cJSON_CreateObject();
+    if (!o) return NULL;
+#define NUMBER(field) cJSON_AddNumberToObject(o,#field,s_settings.field)
+#define BOOL(field) cJSON_AddBoolToObject(o,#field,s_settings.field)
+    NUMBER(fps); NUMBER(jpeg_quality); NUMBER(exposure); NUMBER(exposure_level);
+    NUMBER(white_balance_mode); NUMBER(gain);
+    BOOL(auto_exposure); BOOL(auto_white_balance); BOOL(auto_gain);
+#undef BOOL
+#undef NUMBER
+    cJSON_AddStringToObject(o,"resolution",camera_resolution_names[s_settings.resolution]);
+    return o;
+}
+static esp_err_t send_json(httpd_req_t *req,cJSON *object)
+{
+    if (!object) return httpd_resp_send_err(req,HTTPD_500_INTERNAL_SERVER_ERROR,"Out of memory");
+    char *text=cJSON_PrintUnformatted(object);
+    cJSON_Delete(object);
+    if (!text) return httpd_resp_send_err(req,HTTPD_500_INTERNAL_SERVER_ERROR,"Out of memory");
+    httpd_resp_set_type(req,"application/json; charset=utf-8");
+    httpd_resp_set_hdr(req,"Cache-Control","no-store");
+    esp_err_t err=httpd_resp_sendstr(req,text);
+    free(text);
+    return err;
+}
+static esp_err_t busy_response(httpd_req_t *req)
+{
+    httpd_resp_set_status(req,"503 Service Unavailable");
+    return httpd_resp_sendstr(req,"Camera busy; retry");
+}
+static esp_err_t status_handler(httpd_req_t *req)
+{
+    if (!camera_runtime_lock(2000)) return busy_response(req);
+    cJSON *root=cJSON_CreateObject();
+    cJSON *settings=settings_json();
+    bool consistent=s_sensor_consistent, persisted=s_persisted;
+    camera_runtime_unlock();
+    if (!root || !settings) {cJSON_Delete(root);cJSON_Delete(settings);return httpd_resp_send_err(req,HTTPD_500_INTERNAL_SERVER_ERROR,"Out of memory");}
+    cJSON_AddBoolToObject(root,"ok",consistent);
+    cJSON_AddItemToObject(root,"settings",settings);
+    cJSON_AddBoolToObject(root,"settings_persisted",persisted);
+    cJSON_AddBoolToObject(root,"sensor_consistent",consistent);
+    cJSON_AddStringToObject(root,"firmware_version",CAMERA_FIRMWARE_VERSION);
+    cJSON *firmware=cJSON_AddObjectToObject(root,"firmware");
+    const esp_app_desc_t *app=esp_app_get_description();
+    char hash[65];
+    for(int i=0;i<32;i++) snprintf(hash+i*2,3,"%02x",app->app_elf_sha256[i]);
+    cJSON_AddStringToObject(firmware,"version",app->version);
+    cJSON_AddStringToObject(firmware,"project",app->project_name);
+    cJSON_AddStringToObject(firmware,"idf_version",app->idf_ver);
+    cJSON_AddStringToObject(firmware,"build_date",app->date);
+    cJSON_AddStringToObject(firmware,"build_time",app->time);
+    cJSON_AddStringToObject(firmware,"elf_sha256",hash);
+    cJSON_AddStringToObject(root,"name",wifi_manager_get_device_name());
+    esp_ip4_addr_t ip=wifi_manager_get_ip();char address[24];
+    snprintf(address,sizeof(address),IPSTR,IP2STR(&ip));cJSON_AddStringToObject(root,"ip",address);
+    cJSON *wifi=cJSON_AddObjectToObject(root,"wifi");char ssid[33]={0};
+    wifi_manager_get_saved_ssid(ssid,sizeof(ssid));
+    cJSON_AddStringToObject(wifi,"ssid",ssid);
+    cJSON_AddStringToObject(wifi,"mode",wifi_manager_get_mode_name());
+    wifi_ps_type_t ps;
+    if (esp_wifi_get_ps(&ps)==ESP_OK) cJSON_AddBoolToObject(wifi,"power_save",ps != WIFI_PS_NONE);
+    else cJSON_AddNullToObject(wifi,"power_save");
+    cJSON *clock=cJSON_AddObjectToObject(root,"time_sync");
+    portENTER_CRITICAL(&s_time_mux);
+    int64_t last=s_last_sync_us, last_monotonic=s_last_sync_monotonic_us;
+    portEXIT_CRITICAL(&s_time_mux);
+    double age=(double)(esp_timer_get_time()-last_monotonic)/1000000.0;
+    cJSON_AddStringToObject(clock,"server",CAMERA_SNTP_SERVER);
+    cJSON_AddBoolToObject(clock,"synced",last>0 && age<180.0 && wifi_manager_is_connected());
+    cJSON_AddNumberToObject(clock,"sync_interval_seconds",60);
+    if(last>0)cJSON_AddNumberToObject(clock,"last_sync_age_seconds",age);
+    else cJSON_AddNullToObject(clock,"last_sync_age_seconds");
+    if(last>0)cJSON_AddNumberToObject(clock,"last_sync_unix_us",(double)last);
+    else cJSON_AddNullToObject(clock,"last_sync_unix_us");
+    cJSON_AddNumberToObject(root,"uptime_us",(double)esp_timer_get_time());
+    return send_json(req,root);
+}
+
+static cJSON *read_json(httpd_req_t *req)
+{
+    if(req->content_len<=0 || req->content_len>1536) return NULL;
+    char *body=malloc(req->content_len+1);
+    if(!body)return NULL;
+    int read=0,timeouts=0;
+    while(read<req->content_len) {
+        int n=httpd_req_recv(req,body+read,req->content_len-read);
+        if(n==HTTPD_SOCK_ERR_TIMEOUT && ++timeouts<=2)continue;
+        if(n<=0){free(body);return NULL;}
+        read+=n;
+    }
+    body[read]=0;
+    if (!camera_json_body_valid(body,(size_t)read)) { free(body); return NULL; }
+    cJSON *json=cJSON_ParseWithLengthOpts(body,read+1,NULL,true);
+    free(body);
+    if(!cJSON_IsObject(json)){cJSON_Delete(json);return NULL;}
+    // Duplicate keys are ambiguous: reject rather than silently apply one copy.
+    cJSON *a,*b;
+    cJSON_ArrayForEach(a,json) for(b=a->next;b;b=b->next)
+        if(!strcmp(a->string,b->string)){cJSON_Delete(json);return NULL;}
+    return json;
+}
+static esp_err_t settings_handler(httpd_req_t *req)
+{
+    if(req->method==HTTP_GET) {
+        if(!camera_runtime_lock(2000))return busy_response(req);
+        cJSON *json=settings_json();camera_runtime_unlock();return send_json(req,json);
+    }
+    cJSON *json=read_json(req);
+    if(!json)return httpd_resp_send_err(req,HTTPD_400_BAD_REQUEST,"Expected one JSON object (max 1536 bytes)");
+    if(!camera_runtime_lock(2000)){cJSON_Delete(json);return busy_response(req);}
+    camera_settings_t old=s_settings,next=old;
+    bool valid=camera_settings_patch(&next,json);cJSON_Delete(json);
+    if(!valid){camera_runtime_unlock();return httpd_resp_send_err(req,HTTPD_400_BAD_REQUEST,"Unknown field, type, or range; see /settings");}
+    if(!camera_settings_transaction(&s_settings,&next,&s_sensor_consistent,&s_persisted,
+            apply_settings_io,save_settings_io,NULL)) {
+        camera_runtime_unlock();
+        return httpd_resp_send_err(req,HTTPD_500_INTERNAL_SERVER_ERROR,"Apply/save failed; query /api/status before continuing");
+    }
+    cJSON *response=cJSON_CreateObject();
+    cJSON_AddBoolToObject(response,"ok",true);cJSON_AddBoolToObject(response,"saved",true);
+    cJSON_AddItemToObject(response,"settings",settings_json());
+    camera_runtime_unlock();return send_json(req,response);
+}
+static void restart_wifi(void *unused)
+{
+    (void)unused;vTaskDelay(pdMS_TO_TICKS(1500));esp_restart();
+}
+static esp_err_t wifi_handler(httpd_req_t *req)
+{
+    cJSON *root=read_json(req);
+    if(!root)return httpd_resp_send_err(req,HTTPD_400_BAD_REQUEST,"Expected JSON {ssid,password}");
+    const cJSON *ssid=cJSON_GetObjectItemCaseSensitive(root,"ssid");
+    const cJSON *password=cJSON_GetObjectItemCaseSensitive(root,"password");
+    bool valid=cJSON_GetArraySize(root)==2 && cJSON_IsString(ssid) && cJSON_IsString(password);
+    esp_err_t err=valid?wifi_manager_save_sta(ssid->valuestring,password->valuestring):ESP_ERR_INVALID_ARG;
+    cJSON_Delete(root);
+    if(err!=ESP_OK)return httpd_resp_send_err(req,HTTPD_400_BAD_REQUEST,"Invalid Wi-Fi configuration or NVS save failed");
+    if(xTaskCreate(restart_wifi,"wifi_restart",2048,NULL,5,NULL)!=pdPASS)
+        return httpd_resp_send_err(req,HTTPD_500_INTERNAL_SERVER_ERROR,"Wi-Fi saved; restart manually to apply");
+    httpd_resp_set_type(req,"application/json; charset=utf-8");
+    return httpd_resp_sendstr(req,"{\"ok\":true,\"saved\":true,\"restarting\":true}");
+}
+static esp_err_t settings_page(httpd_req_t *req)
+{
+    static const char page[]=
+    "<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
+    "<title>相机运行参数</title><style>body{font:16px sans-serif;max-width:760px;margin:30px auto;padding:16px}"
+    "textarea{width:100%;height:330px}button{padding:10px;margin:10px 0}pre{white-space:pre-wrap}</style>"
+    "<h1>相机运行参数</h1><p><a href='/'>Wi-Fi 配置</a> · <a href='/api/status'>版本与同步状态</a></p>"
+    "<p>修改 JSON 后保存，立即应用并存入 NVS。resolution: 160x120 / 320x240 / 640x480 / 800x600 / 1024x768 / 1280x1024 / 1600x1200。"
+    "fps: 1–30（图传上限）；jpeg_quality: 4–63（越小质量越高）。</p>"
+    "<p>auto_exposure / auto_white_balance / auto_gain: true 或 false。exposure: 0–1200（传感器寄存器单位，非微秒，仅手动曝光时应用）；"
+    "exposure_level: -2–2；gain: 0–30（仅手动增益时应用）。white_balance_mode: 0 自动、1 晴天、2 阴天、3 办公室、4 家居。"
+    "手动白平衡请设 auto_white_balance=false 并选择1–4；自动请设true和0。</p>"
+    "<textarea id=cfg spellcheck=false></textarea><br><button id=save>应用并保存</button><pre id=result></pre>"
+    "<script>fetch('/api/settings').then(r=>r.json()).then(s=>cfg.value=JSON.stringify(s,null,2));"
+    "save.onclick=async()=>{try{const body=JSON.stringify(JSON.parse(cfg.value));const r=await fetch('/api/settings',{method:'POST',headers:{'Content-Type':'application/json'},body});result.textContent=r.status+' '+await r.text()}catch(e){result.textContent=String(e)}};</script>";
+    httpd_resp_set_type(req,"text/html; charset=utf-8");
+    return httpd_resp_sendstr(req,page);
+}
+esp_err_t camera_runtime_register_http(httpd_handle_t server)
+{
+    const httpd_uri_t uris[]={
+        {.uri="/api/status",.method=HTTP_GET,.handler=status_handler},
+        {.uri="/api/settings",.method=HTTP_GET,.handler=settings_handler},
+        {.uri="/api/settings",.method=HTTP_POST,.handler=settings_handler},
+        {.uri="/api/wifi",.method=HTTP_POST,.handler=wifi_handler},
+        {.uri="/settings",.method=HTTP_GET,.handler=settings_page}
+    };
+    for(size_t i=0;i<sizeof(uris)/sizeof(uris[0]);i++) {
+        esp_err_t err=httpd_register_uri_handler(server,&uris[i]);
+        if(err!=ESP_OK)return err;
+    }
+    return ESP_OK;
+}
