diff --git a/tests/test_camera_settings.c b/tests/test_camera_settings.c
new file mode 100644
index 0000000..c191008
--- /dev/null
+++ b/tests/test_camera_settings.c
@@ -0,0 +1,51 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../main/camera_settings.h"
+
+typedef struct {int applies,saves;bool fail_apply,fail_save,fail_rollback;camera_settings_t last_applied,last_saved;} io_t;
+static bool apply(const camera_settings_t *s,void *ctx) {
+    io_t *io=ctx;io->last_applied=*s;io->applies++;
+    return !(io->fail_apply && io->applies==1) && !(io->fail_rollback && io->applies>1);
+}
+static bool save(const camera_settings_t *s,void *ctx) {
+    io_t *io=ctx;io->last_saved=*s;io->saves++;
+    return !(io->fail_save && io->saves==1) && !(io->fail_rollback && io->saves>1);
+}
+int main(void) {
+    camera_settings_t defaults;camera_settings_defaults(&defaults);assert(camera_settings_valid(&defaults));
+    camera_settings_t s=defaults;
+#define BAD(field,value) do{s=defaults;s.field=value;assert(!camera_settings_valid(&s));}while(0)
+    BAD(fps,0);BAD(fps,31);BAD(jpeg_quality,3);BAD(jpeg_quality,64);BAD(resolution,-1);BAD(resolution,7);
+    BAD(auto_exposure,2);BAD(auto_gain,-1);BAD(auto_white_balance,7);BAD(gain,31);BAD(exposure,1201);BAD(exposure,-1);
+    BAD(white_balance_mode,1);BAD(auto_white_balance,0);
+    s=defaults;s.auto_white_balance=0;s.white_balance_mode=2;assert(camera_settings_valid(&s));
+    BAD(exposure_level,3);BAD(exposure_level,-3);BAD(white_balance_mode,5);BAD(schema,99);
+#undef BAD
+    assert(camera_resolution_index("640x480")==2);assert(camera_resolution_index("640X480")==-1);
+    for(int i=0;i<CAMERA_RESOLUTION_COUNT;i++)assert(camera_resolution_index(camera_resolution_names[i])==i);
+    puts("PASS: defaults, parameter bounds, schema and resolution whitelist");
+    camera_settings_t next=defaults;next.fps=10;next.gain=12;next.auto_gain=0;
+    bool consistent=true,persisted=false;io_t io={0};s=defaults;
+    assert(camera_settings_transaction(&s,&next,&consistent,&persisted,apply,save,&io));
+    assert(s.fps==10 && consistent && persisted && io.applies==1 && io.saves==1);
+    puts("PASS: successful transaction applies, persists and publishes settings");
+    io=(io_t){.fail_apply=true};s=defaults;persisted=false;
+    assert(!camera_settings_transaction(&s,&next,&consistent,&persisted,apply,save,&io));
+    assert(!memcmp(&s,&defaults,sizeof(s))&&consistent&&!persisted&&io.applies==2&&io.saves==0);
+    assert(!memcmp(&io.last_applied,&defaults,sizeof(s)));
+    puts("PASS: partial sensor apply restores prior settings and never writes NVS");
+    io=(io_t){.fail_save=true};s=defaults;
+    assert(!camera_settings_transaction(&s,&next,&consistent,&persisted,apply,save,&io));
+    assert(!memcmp(&s,&defaults,sizeof(s))&&consistent&&persisted&&io.applies==2&&io.saves==2);
+    assert(!memcmp(&io.last_saved,&defaults,sizeof(s)));
+    puts("PASS: persistence failure restores both sensor and persisted record");
+    io=(io_t){.fail_save=true,.fail_rollback=true};s=defaults;
+    assert(!camera_settings_transaction(&s,&next,&consistent,&persisted,apply,save,&io));
+    assert(!consistent&&!persisted&&!memcmp(&s,&defaults,sizeof(s)));
+    puts("PASS: failed rollback is explicitly inconsistent and unsaved (stream must stop)");
+    io=(io_t){0};next.fps=0;
+    assert(!camera_settings_transaction(&s,&next,&consistent,&persisted,apply,save,&io));
+    assert(io.applies==0&&io.saves==0);
+    puts("PASS: invalid transaction never touches hardware or NVS");
+}
