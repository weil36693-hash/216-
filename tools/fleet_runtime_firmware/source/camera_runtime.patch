index 0000000..5bbbd46
--- /dev/null
+++ b/tests/test_mjpeg_stream.c
@@ -0,0 +1,224 @@
+// Compile the production handler itself against deterministic hardware stubs.
+#include <stdio.h>
+#include <string.h>
+#include "test_esp.h"
+#include "../main/web_mjpeg.c"
+
+enum { MAX_FRAMES = 32 };
+static struct {
+    int64_t now_us;
+    int64_t starts[MAX_FRAMES];
+    int64_t capture_delay[MAX_FRAMES];
+    int64_t payload_delay[MAX_FRAMES];
+    int captures, returns, boundaries, completed, delays;
+    int max_completed, phase, fail_phase, fail_capture;
+    bool held, early_wake, type_failure, fps_header, locked;
+    int fps, change_fps_after_frame;
+    uint8_t jpeg[4];
+    camera_fb_t fb;
+    esp_err_t (*handler)(httpd_req_t *);
+} fake;
+
+static void reset_fake(void)
+{
+    memset(&fake, 0, sizeof(fake));
+    fake.now_us = 1000000;
+    fake.max_completed = 4;
+    fake.fps = 5;
+    fake.fail_phase = -1;
+    fake.fail_capture = -1;
+    fake.jpeg[0] = 0xff;
+    fake.jpeg[1] = 0xd8;
+    fake.jpeg[2] = 0xff;
+    fake.jpeg[3] = 0xd9;
+    fake.fb = (camera_fb_t){fake.jpeg, sizeof(fake.jpeg), PIXFORMAT_JPEG};
+}
+
+bool camera_runtime_lock(uint32_t timeout_ms) { (void)timeout_ms; assert(!fake.locked); fake.locked=true; return true; }
+void camera_runtime_unlock(void) { assert(fake.locked); assert(!fake.held); fake.locked=false; }
+int camera_runtime_get_fps(void) { assert(fake.locked); return fake.fps; }
+bool camera_runtime_stream_ready(void) { assert(fake.locked); return true; }
+int64_t esp_timer_get_time(void) { return fake.now_us; }
+
+void vTaskDelay(TickType_t ticks)
+{
+    // Holding a framebuffer while sleeping would starve the camera queue.
+    assert(!fake.held);
+    assert(!fake.locked);
+    assert(ticks > 0);
+    ++fake.delays;
+    int64_t elapsed = (int64_t)ticks * 10000;
+    if (fake.early_wake && fake.delays == 1) elapsed -= 5000;
+    assert(elapsed > 0);
+    fake.now_us += elapsed;
+}
+
+camera_fb_t *esp_camera_fb_get(void)
+{
+    assert(!fake.held);
+    assert(fake.locked);
+    assert(fake.captures < MAX_FRAMES);
+    int index = fake.captures++;
+    fake.now_us += fake.capture_delay[index];
+    if (index == fake.fail_capture) return NULL;
+    fake.held = true;
+    return &fake.fb;
+}
+
+void esp_camera_fb_return(camera_fb_t *fb)
+{
+    assert(fb == &fake.fb);
+    assert(fake.held);
+    fake.held = false;
+    ++fake.returns;
+}
+
+esp_err_t httpd_resp_set_type(httpd_req_t *req, const char *type)
+{
+    (void)req;
+    assert(strcmp(type, "multipart/x-mixed-replace;boundary=frame") == 0);
+    return fake.type_failure ? ESP_FAIL : ESP_OK;
+}
+
+esp_err_t httpd_resp_set_hdr(httpd_req_t *req, const char *name, const char *value)
+{
+    (void)req;
+    if (strcmp(name, "X-Camera-Stream-FPS") == 0) {
+        assert(strcmp(value, "5") == 0);
+        fake.fps_header = true;
+    }
+    return ESP_OK;
+}
+
+esp_err_t httpd_resp_send_chunk(httpd_req_t *req, const char *data, size_t len)
+{
+    (void)req;
+    assert(fake.held);
+    if (fake.phase == 0) {
+        assert(len == strlen("\r\n--frame\r\n"));
+        assert(memcmp(data, "\r\n--frame\r\n", len) == 0);
+        assert(fake.boundaries < MAX_FRAMES);
+        fake.starts[fake.boundaries++] = fake.now_us;
+        // A deterministic client disconnect terminates the production loop.
+        if (fake.completed >= fake.max_completed) return ESP_FAIL;
+    } else if (fake.phase == 1) {
+        assert(len == strlen("Content-Type: image/jpeg\r\n\r\n"));
+        assert(memcmp(data, "Content-Type: image/jpeg\r\n\r\n", len) == 0);
+    } else {
+        assert(data == (const char *)fake.fb.buf);
+        assert(len == fake.fb.len);
+        fake.now_us += fake.payload_delay[fake.completed];
+    }
+    if (fake.phase == fake.fail_phase) return ESP_FAIL;
+    if (++fake.phase == 3) {
+        fake.phase = 0;
+        ++fake.completed;
+        if (fake.completed == 1 && fake.change_fps_after_frame) fake.fps = fake.change_fps_after_frame;
+    }
+    return ESP_OK;
+}
+
+esp_err_t httpd_start(httpd_handle_t *server, const httpd_config_t *config)
+{
+    assert(config->server_port == 81);
+    *server = &fake;
+    return ESP_OK;
+}
+
+esp_err_t httpd_register_uri_handler(httpd_handle_t server, const httpd_uri_t *uri)
+{
+    assert(server == &fake);
+    assert(strcmp(uri->uri, "/") == 0 && uri->method == HTTP_GET);
+    fake.handler = uri->handler;
+    return ESP_OK;
+}
+
+static void run_handler(void)
+{
+    httpd_req_t req = {0};
+    assert(start_webserver() == &fake);
+    assert(fake.handler != NULL);
+    assert(fake.handler(&req) == ESP_FAIL);
+    assert(!fake.held);
+}
+
+static void check_intervals(void)
+{
+    for (int i = 1; i < fake.boundaries; ++i) {
+        assert(fake.starts[i] - fake.starts[i - 1] >= 200000);
+    }
+}
+
+int main(void)
+{
+    reset_fake();
+    for (int i = 0; i < MAX_FRAMES; ++i) fake.payload_delay[i] = 20000;
+    run_handler();
+    assert(fake.fps_header && fake.completed == 4);
+    assert(fake.captures == fake.returns);
+    for (int i = 0; i < fake.boundaries; ++i) {
+        // The 20 ms send time must be included, not added to a 200 ms sleep.
+        assert(fake.starts[i] == 1000000 + i * 200000);
+    }
+    puts("PASS: 5 FPS cadence includes send time; waits hold no frame");
+
+    reset_fake();
+    fake.payload_delay[0] = 450000;
+    fake.payload_delay[1] = 10000;
+    run_handler();
+    check_intervals();
+    assert(fake.starts[1] == 1450000);
+    assert(fake.starts[2] == 1650000);
+    assert(fake.captures == fake.returns);
+    puts("PASS: slow network resets cadence without catch-up bursts");
+
+    reset_fake();
+    fake.early_wake = true;
+    run_handler();
+    check_intervals();
+    assert(fake.delays > fake.completed);
+    assert(fake.starts[1] == 1205000);
+    puts("PASS: early tick wake is rechecked before sending");
+
+    reset_fake();
+    fake.capture_delay[0] = 60000;
+    fake.capture_delay[2] = 300000;
+    run_handler();
+    check_intervals();
+    assert(fake.starts[0] == 1060000);
+    assert(fake.starts[1] == 1260000);
+    assert(fake.starts[2] == 1760000);
+    assert(fake.starts[3] == 1960000);
+    puts("PASS: varying capture latency cannot shorten send intervals");
+
+    for (int phase = 0; phase < 3; ++phase) {
+        reset_fake();
+        fake.fail_phase = phase;
+        run_handler();
+        assert(fake.captures == 1 && fake.returns == 1 && fake.completed == 0);
+    }
+    puts("PASS: boundary, header, and payload failures return the frame exactly once");
+
+    reset_fake();
+    fake.fail_capture = 0;
+    run_handler();
+    assert(fake.returns == 0 && fake.boundaries == 0);
+    reset_fake();
+    fake.jpeg[0] = 0;
+    run_handler();
+    assert(fake.returns == 1 && fake.boundaries == 0);
+    reset_fake();
+    fake.type_failure = true;
+    run_handler();
+    assert(fake.captures == 0);
+    puts("PASS: capture, invalid JPEG, and HTTP setup failures release resources");
+    reset_fake();
+    fake.change_fps_after_frame = 2;
+    run_handler();
+    assert(fake.starts[1] - fake.starts[0] == 200000);
+    assert(fake.starts[2] - fake.starts[1] == 500000);
+    assert(fake.starts[3] - fake.starts[2] == 500000);
+    assert(!fake.locked && !fake.held);
+    puts("PASS: runtime FPS change is used by next frame; mutex released on disconnect");
+    return 0;
+}
diff --git a/tests/test_settings_json.c b/tests/test_settings_json.c
